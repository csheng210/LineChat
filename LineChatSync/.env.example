# LineChatSync 環境設定範本(複製為 .env 後填入)。
# 使用: 保留本範本入庫, 另存 .env(.env 已被 .gitignore 忽略)填入真實值。

# ---- Kafka ----
KAFKA_BROKERS=remote.travel-penghu.com.tw:29092
KAFKA_CLIENT_ID=linechat-sync
KAFKA_GROUP_ID=linechat-sync
KAFKA_TOPIC_IN=events-line-message
# 第二個觸發同步的 topic(與 TOPIC_IN 共用同一套處理)
KAFKA_TOPIC_SYNC=events-line-sync
KAFKA_TOPIC_OUT=events-line-synced
KAFKA_CONNECT_TIMEOUT_MS=15000
KAFKA_REQUEST_TIMEOUT_MS=30000
# mainloop 每輪 poll 逾時(毫秒)
KAFKA_POLL_TIMEOUT_MS=1000
# 選填: 遠端 broker 需要認證時才設
# KAFKA_SSL=1
# KAFKA_SASL_MECHANISM=plain
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# ---- 觸發 LineChatActions 的同步 ----
ACTIONS_BASE_URL=http://127.0.0.1:8202
SYNC_DEBOUNCE_MS=15000
SYNC_MAX_BATCH_MS=120000
SYNC_DAYS=2
SYNC_INCLUDE_UNREAD=1
SYNC_AUTO_WINDOW=1
SYNC_POLL_MS=3000
SYNC_TRIGGER_TIMEOUT_MS=1860000
