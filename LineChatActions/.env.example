# LineChatActions 環境變數(可不設, 全用預設值)。要覆蓋請另存為 .env 並由啟動腳本/系統帶入。
# 只綁本機; 這個服務能真的發 LINE 訊息, 切勿對外網開放。
ACTIONS_HOST=127.0.0.1
ACTIONS_PORT=8010

# 持久化 Chrome Profile(與抓歷史/回填等批次腳本共用同一份 -> playwright 版本須一致, 預設用 repo 根 chrome_profile)
# LINE_CHAT_PROFILE_DIR=C:\path\to\chrome_profile

# 閒置多久(毫秒)自動關閉 Chrome 以釋放 profile 給批次腳本; 0 = 不自動關
ACTIONS_IDLE_MS=600000
# 送訊等待佇列上限(串行執行, 超過回 429)
ACTIONS_MAX_QUEUE=5
# 進入聊天室時手動登入/輸入驗證碼的等待上限(毫秒)
ACTIONS_MANUAL_LOGIN_MS=120000
# 單次送訊總時程上限(毫秒, 含開Chrome/登入/進入/輸入/點傳送)
ACTIONS_SEND_TIMEOUT_MS=300000

# ---- 同步聊天紀錄(內建於本服務, 非外部腳本) ----
# 同步涵蓋的帳號(逗號分隔); 不設 = 全部已知帳號依序同步
# ACTIONS_SYNC_ACCOUNTS=澎湖民宿藍海天晴,澎湖民宿藍海風晴,飛樂米|澎湖民宿
# 同步近 N 天的聊天清單與訊息(預設 2)
ACTIONS_SYNC_DAYS=2
# 是否一併以預覽方式抓取未讀訊息(0 = 略過未讀, 預設含未讀)
ACTIONS_SYNC_INCLUDE_UNREAD=1
# 單次同步總時程上限(毫秒, 含逐帳號抓取/合併/回填)
ACTIONS_SYNC_TIMEOUT_MS=1800000
# 回填語意的 Python 執行檔(需在 PATH 或給絕對路徑; 預設 python)
# ACTIONS_PYTHON=python
# 共用語意快取 DB(預設 repo 根 chat-history-img-url-cache.db; 與 root 批次腳本共用同一份)
# LINE_CHAT_CACHE_DB=C:\path\to\chat-history-img-url-cache.db
# 聊天紀錄/圖片輸出目錄(預設 repo 根 chat_history 與 chat_media)
# LINE_CHAT_HISTORY_DIR=C:\path\to\chat_history
# ---- 資料目錄總開關(單一設定整組切換) ----
# chat_history / chrome_profile / chat_media / chat_analysis / chat-history-img-url-cache.db / 民宿客服問題分類.md
# 全部由此目錄衍生; 換一份資料就改這一行(未設=沿用 repo 根)。
# LINE_CHAT_DATA_DIR=C:\path\to\data
# 單項若要偏離總開關可單獨覆寫(優先於 DATA_DIR):
# LINE_CHAT_PROFILE_DIR / LINE_CHAT_HISTORY_DIR / LINE_CHAT_MEDIA_DIR / LINE_CHAT_ANALYSIS_DIR / LINE_CHAT_CACHE_DB / LINE_CHAT_CLASSIFICATION_MD
# LINE_CHAT_MEDIA_DIR=C:\path\to\chat_media

# ---- 建議回覆(chat_vllm_suggest.py) ----
# 建議回覆的 RAG 目錄(內含 maps.json / agents.json / reference/); 預設 question_class_rag
# ACTIONS_RAG_DIR=C:\path\to\question_class_rag
# 呼叫 agent service(如 room_agent 走 LLM tool-calling)的逾時秒數(預設 150)。
# 抓不到 agent 時會退回讀參考文檔; 若 agent 常逾時可調高此值。
ACTIONS_AGENT_TIMEOUT=150

# ---- vLLM 語意辨識服務(回填 sticker/image 語意) ----
# 圖片語意辨識用的 vLLM OpenAI 相容 API 位置; 端點更動時改這裡即可(預設 http://llmhost:8189/v1)。
# VLLM_BASE_URL=http://llmhost:8189/v1

# ---- LINE 桌面 App 送訊(POST /send-app, pywinauto) ----
# 用本專案 .venv 的 python(內含 pywinauto); 若要換執行檔給絕對路徑(預設 .venv\Scripts\python.exe)。
# ACTIONS_APP_PYTHON=C:\path\to\LineChatActions\.venv\Scripts\python.exe
# 單次 App 送訊總時程上限(毫秒, 含啟動 LINE/搜尋/輸入/送出; 預設 120000)。
ACTIONS_APP_SEND_TIMEOUT_MS=120000

