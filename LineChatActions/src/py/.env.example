# LineAppActions 環境設定範本 (可入庫, 不含機密)
# 用法: 複製本檔為 .env 後填入真實值 ->  Copy-Item .env.example .env
# .env 已被 .gitignore 排除, 不會入庫; open_line.py 啟動時自動載入。

# --- LINE App 執行檔路徑 ---
# 預設會自動偵測 %LOCALAPPDATA%\LINE\bin\LineLauncher.exe 與開始選單捷徑。
# 若你的 LINE 裝在別處, 在此填入絕對路徑 (建議指向 LineLauncher.exe)。
LINE_APP_PATH=

# --- 啟動後等待主視窗出現的秒數 ---
LINE_WINDOW_TIMEOUT=30
