# LineChatAPI 環境設定範本 (可入庫, 不含機密)
# 用法: 複製本檔為 .env 後填入真實值 ->  Copy-Item .env.example .env
# .env 已被 .gitignore 排除, 不會入庫; 啟動 main.py 或 import uPenghu_mgr 時自動載入。
# 載入規則: 真實環境變數優先, 本檔只補入尚未設定的項目。

# --- vLLM (OpenAI 相容端點) ---
VLLM_BASE_URL=http://localhost:8189/v1
VLLM_MODEL=swift-1.5-iq3_xxs
VLLM_API_KEY=llamacpp
VLLM_TIMEOUT=120

# --- uPenghu 管理端 Web API (svc125): 訂單 / 公司查詢 ---
MGR_SERVER_API_BASE=http://svc125.u-penghu.tw:8080
MGR_SERVER_API_TIMEOUT=20
MGR_DEFAULT_CPID=1,2,105

# --- mgr125 管理站驗證 token (空房與需求單共用, 以 Cookie PenghuLookAccessToken 傳送) ---
# 請填入自己的有效 JWT; 範本刻意留空, 切勿把真實 token 提交到 .env.example
MGR_TOKEN=

# --- 空房查詢 (uPenghu_mgr/api_clients/productbk_api.py) ---
MGR_FREEROOM_URL=http://mgr125.u-penghu.tw/mgr/freeproductquery
MGR_TIMEOUT=25
# 選填: Referer 預設同 MGR_FREEROOM_URL, 通常不必設
# MGR_REFERER=

# --- 需求單查詢 (uPenghu_mgr/api_clients/demand_api.py) ---
MGR_DEMAND_URL=http://mgr125.u-penghu.tw/Demand/ListNew
MGR_DEMAND_TIMEOUT=25

# --- 聊天紀錄 / 媒體目錄 (main.py, 選填; 不設則用 repo 內預設路徑) ---
# CHAT_HISTORY_DIR=
# LINE_CHAT_MEDIA_DIR=

# --- .env 位置覆寫 (選填; 預設即為 LineChatAPI/.env) ---
# MGR_ENV_FILE=

# --- 整合測試開關 (跑需要真實網路的 uPenghu_mgr.Tests.test_company_api 時設 1) ---
MGR_TEST_INTEGRATION=0

# ---- LineChatAPI 專屬資料目錄(與 LineChatActions 的 LINE_CHAT_DATA_DIR 完全分開) ----
# chat_history JSON 目錄(未設=repo 根/chat_history)
# LINE_CHAT_API_CHAT_DIR=C:\path\to\chat_history
# chat_media 圖片本機副本目錄(未設=CHAT 目錄同層的 chat_media)
# LINE_CHAT_API_MEDIA_DIR=C:\path\to\chat_media

# ---- LineChatAPI 服務監聽位址 (main.py 啟動 uvicorn 時讀取) ----
LINE_CHAT_API_HOST=127.0.0.1
LINE_CHAT_API_PORT=8000
