# LineChatWeb 環境設定範本(複製為 .env 並填入值; .env 已被 .gitignore 忽略, 不入库)。
# import.meta.env 只暴露 VITE_ 前綴的變數。

# ---- LINE Messaging API ----
VITE_LINE_CHANNEL_ACCESS_TOKEN=
VITE_LINE_REPLY_PREFIX=Reply：
VITE_LINE_CHANNEL_SECRET=

# ---- 後端 proxy target(供 vite.config.js 讀取) ----
VITE_API_TARGET=http://127.0.0.1:8201
VITE_ACTIONS_TARGET=http://127.0.0.1:8202
VITE_COMFY_TARGET=http://127.0.0.1:8204
VITE_FLIGHTS_TARGET=http://127.0.0.1:8205

# ---- dev server 監聽 ----
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=8200
VITE_DEV_ALLOWED_HOSTS=true

# ---- 反推提示詞/模型聊天 的 VLM 模型清單(供前端選單讀取, 不寫死在程式) ----
# 格式: 以 ';' 分隔多個模型, 每個模型以 '|' 分隔欄位 -> id|label|base_url|api_key; 預設選第一項。
VITE_VTP_MODELS=qwen3.8-27b-uncensored|Qwen3.8-27B Uncensored|http://svc.summer-blue.com:18300/v1|llamacpp;swift-1.5-iq3_xxs|Swift 1.5 IQ3|http://svc.summer-blue.com:8189/v1|llamacpp
